{
  "name": "sygshift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint src worker --deny-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "inventory:access": "node tools/access-control-inventory.mjs --verify",
    "inventory:access:production": "node tools/capture-production-access-baseline.mjs",
    "inventory:access:boundaries": "node tools/capture-production-role-boundaries.mjs",
    "check:hris-foundation": "node tools/validate-hris-foundation.mjs",
    "check:hris-core": "node tools/validate-hris-core-architecture.mjs",
    "check:hris-reconciliation": "node tools/validate-hris-stage2-reconciliation.mjs",
    "check:hris-backfill-controls": "node tools/validate-hris-stage2-backfill-controls.mjs",
    "check:hris-backfill-release": "node tools/validate-hris-stage2-backfill-release.mjs",
    "check:hris-readiness": "node tools/validate-hris-stage2-readiness-workspace.mjs",
    "check:hris-people": "node tools/validate-hris-stage3-people-workspace.mjs",
    "check:hris-employee-file": "node tools/validate-hris-comprehensive-employee-file.mjs",
    "check:hris-documents": "node tools/validate-hris-stage4-document-foundation.mjs",
    "check:hris-document-pipeline": "node tools/validate-hris-stage4-document-pipeline.mjs",
    "check:hris-document-workspace": "node tools/validate-hris-stage4-document-workspace.mjs",
    "check:hris-document-workflows": "node tools/validate-hris-stage4-document-workflows.mjs",
    "check:hris-automation": "node tools/validate-hris-stage5-automation.mjs",
    "check:hris-recruiting-onboarding": "node tools/validate-hris-stage6-recruiting-onboarding.mjs",
    "check:hris-leave-benefits-compensation": "node tools/validate-hris-stage7-leave-benefits-compensation.mjs",
    "check:hris-talent-learning-cases-safety-assets": "node tools/validate-hris-stage8-talent-learning-cases-safety-assets.mjs",
    "check:hris-offboarding-self-service-reporting": "node tools/validate-hris-stage9-offboarding-self-service-reporting.mjs",
    "check:hris-payroll-integration": "node tools/validate-hris-stage10-payroll-integration-hardening.mjs",
    "check:hris-admin-baseline": "node tools/validate-hris-admin-permission-baseline.mjs",
    "verify:access:preserved": "node tools/verify-production-access-preservation.mjs outputs/access-control/production-access-baseline-08-21-2026-before-enforcement.json outputs/access-control/production-access-baseline-08-21-2026.json",
    "verify:access:admin-baseline": "node tools/verify-production-admin-permission-baseline.mjs outputs/access-control/production-access-baseline-08-30-2026-before-admin-baseline.json outputs/access-control/production-access-baseline-08-30-2026.json",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "bootstrap:admin": "node tools/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.101.2",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.42.4",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.106.0"
  }
}
