{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sygshift",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "app.sygilant.us",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "SYGSHIFT_PUBLIC_APP_URL": "https://app.sygilant.us",
    "SYGSHIFT_EMAIL_FROM": "scheduling@sygilant.us",
    "SYGSHIFT_EMAIL_FROM_NAME": "SygShift",
    "SYGSHIFT_BLOCKED_EMAIL_DOMAINS": "guardianshipsecurity.net",
    "SYGSHIFT_SECURITY_KEYS_ENABLED": "true",
    "SYGSHIFT_SECURITY_KEY_PILOT_USERNAMES": "jbrown",
    "SYGSHIFT_HR_AUTOMATION_ENABLED": "false",
    "SYGSHIFT_HR_RECRUITING_ENABLED": "false",
    "SYGSHIFT_HR_ONBOARDING_ENABLED": "true",
    "SYGSHIFT_HR_LEAVE_ENABLED": "false",
    "SYGSHIFT_HR_BENEFITS_ENABLED": "false",
    "SYGSHIFT_HR_COMPENSATION_ENABLED": "false",
    "SYGSHIFT_HR_TALENT_ENABLED": "false",
    "SYGSHIFT_HR_LEARNING_ENABLED": "false",
    "SYGSHIFT_HR_CASES_ENABLED": "false",
    "SYGSHIFT_HR_SAFETY_ENABLED": "false",
    "SYGSHIFT_HR_ASSETS_ENABLED": "false",
    "SYGSHIFT_HR_OFFBOARDING_ENABLED": "false",
    "SYGSHIFT_HR_SELF_SERVICE_ENABLED": "false",
    "SYGSHIFT_HR_REPORTING_ENABLED": "false",
    "SYGSHIFT_HR_PAYROLL_INTEGRATION_ENABLED": "false",
    "SYGSHIFT_HR_PAYROLL_WEBHOOKS_ENABLED": "false",
    "SYGSHIFT_HR_ENTERPRISE_CUTOVER_ENABLED": "false",
    "SUPABASE_URL": "https://eqkdfrbwtioiqtjsyglg.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_-uU9fD3XIeZ58r815-fl_Q_g4IIRPQ5",
    "VITE_SUPABASE_URL": "https://eqkdfrbwtioiqtjsyglg.supabase.co",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_-uU9fD3XIeZ58r815-fl_Q_g4IIRPQ5"
  },
  "observability": {
    "enabled": true
  }
}
