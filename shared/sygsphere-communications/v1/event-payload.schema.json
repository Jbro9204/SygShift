{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sygsphere-communications/v1/event-payload.schema.json",
  "oneOf": [
    { "$ref": "#/$defs/authenticated" },
    { "$ref": "#/$defs/authorizationExpiring" },
    { "$ref": "#/$defs/sessionRevoked" },
    { "$ref": "#/$defs/snapshot" },
    { "$ref": "#/$defs/floorPreparing" },
    { "$ref": "#/$defs/floorReady" },
    { "$ref": "#/$defs/floorRenewed" },
    { "$ref": "#/$defs/floorDenied" },
    { "$ref": "#/$defs/floorRevoked" },
    { "$ref": "#/$defs/transmissionStarted" },
    { "$ref": "#/$defs/transmissionEnded" },
    { "$ref": "#/$defs/callRinging" },
    { "$ref": "#/$defs/callRequested" },
    { "$ref": "#/$defs/callAccepted" },
    { "$ref": "#/$defs/callEnded" },
    { "$ref": "#/$defs/callMissed" },
    { "$ref": "#/$defs/meetingCreated" },
    { "$ref": "#/$defs/meetingJoined" },
    { "$ref": "#/$defs/meetingEnded" },
    { "$ref": "#/$defs/participantChanged" },
    { "$ref": "#/$defs/participantRemoved" },
    { "$ref": "#/$defs/participantMuted" },
    { "$ref": "#/$defs/mediaNegotiation" },
    { "$ref": "#/$defs/mediaPolicy" },
    { "$ref": "#/$defs/mediaFailed" },
    { "$ref": "#/$defs/mediaClosed" },
    { "$ref": "#/$defs/cameraGranted" },
    { "$ref": "#/$defs/cameraDenied" },
    { "$ref": "#/$defs/cameraRevoked" },
    { "$ref": "#/$defs/screenGranted" },
    { "$ref": "#/$defs/screenDenied" },
    { "$ref": "#/$defs/screenRevoked" },
    { "$ref": "#/$defs/focusGranted" },
    { "$ref": "#/$defs/focusDenied" },
    { "$ref": "#/$defs/focusRevoked" }
  ],
  "$defs": {
    "event": { "type": "object", "required": ["kind", "payload"], "properties": { "kind": { "type": "string" }, "payload": { "type": "object" } } },
    "uuid": { "type": "string", "format": "uuid" },
    "reference": { "type": "string", "minLength": 1, "maxLength": 128 },
    "time": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 0 },
    "reason": { "enum": ["ended", "cancelled", "declined", "expired", "authorization_changed", "network_lost", "moderated", "unavailable"] },
    "scope": { "enum": ["assignment", "shift", "site", "dispatch"] },
    "mediaKind": { "enum": ["audio", "video", "screen"] },
    "eventPayload": { "type": "object", "unevaluatedProperties": false },
    "authenticated": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "authenticated" }, "payload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["connectionEpoch"], "properties": { "connectionEpoch": { "$ref": "#/$defs/sequence" } } }] } } }] },
    "authorizationExpiring": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "authorization.expiring" }, "payload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["expiresAt"], "properties": { "expiresAt": { "$ref": "#/$defs/time" } } }] } } }] },
    "sessionRevoked": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "session.revoked" }, "payload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["reason"], "properties": { "reason": { "enum": ["authorization_changed", "signed_out", "security_action"] } } }] } } }] },
    "snapshot": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "snapshot" }, "payload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["status"], "properties": { "status": { "enum": ["available", "unavailable"] }, "lastRoomSeq": { "$ref": "#/$defs/sequence" }, "roomVersion": { "$ref": "#/$defs/sequence" } } }] } } }] },
    "floorPreparing": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "floor.preparing" }, "payload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["scope", "transmissionRequestId"], "properties": { "scope": { "$ref": "#/$defs/scope" }, "transmissionRequestId": { "$ref": "#/$defs/uuid" } } }] } } }] },
    "floorReady": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "floor.ready" }, "payload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["expiresAt", "scope", "transmissionRequestId"], "properties": { "expiresAt": { "$ref": "#/$defs/time" }, "scope": { "$ref": "#/$defs/scope" }, "transmissionRequestId": { "$ref": "#/$defs/uuid" } } }] } } }] },
    "floorRenewed": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "floor.renewed" }, "payload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["commandId", "generation", "leaseExpiresAt", "transmissionRequestId"], "properties": { "commandId": { "$ref": "#/$defs/uuid" }, "generation": { "$ref": "#/$defs/sequence" }, "leaseExpiresAt": { "$ref": "#/$defs/time" }, "transmissionRequestId": { "$ref": "#/$defs/uuid" } } }] } } }] },
    "floorDenied": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "floor.denied" }, "payload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["reason", "transmissionRequestId"], "properties": { "reason": { "enum": ["not_allowed", "channel_busy", "unavailable"] }, "transmissionRequestId": { "$ref": "#/$defs/uuid" } } }] } } }] },
    "floorRevoked": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "floor.revoked" }, "payload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["reason", "transmissionRequestId"], "properties": { "reason": { "$ref": "#/$defs/reason" }, "transmissionRequestId": { "$ref": "#/$defs/uuid" } } }] } } }] },
    "transmissionStarted": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "transmission.started" }, "payload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["scope", "transmissionRequestId"], "properties": { "scope": { "$ref": "#/$defs/scope" }, "transmissionRequestId": { "$ref": "#/$defs/uuid" } } }] } } }] },
    "transmissionEnded": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "transmission.ended" }, "payload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["reason", "transmissionRequestId"], "properties": { "reason": { "$ref": "#/$defs/reason" }, "transmissionRequestId": { "$ref": "#/$defs/uuid" } } }] } } }] },
    "callRinging": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "call.ringing" }, "payload": { "$ref": "#/$defs/callInvitationPayload" } } }] },
    "callRequested": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "call.requested" }, "payload": { "$ref": "#/$defs/callInvitationPayload" } } }] },
    "callAccepted": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "call.accepted" }, "payload": { "$ref": "#/$defs/callAcceptedPayload" } } }] },
    "callEnded": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "call.ended" }, "payload": { "$ref": "#/$defs/callEndedPayload" } } }] },
    "callMissed": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "call.missed" }, "payload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "reason"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "reason": { "enum": ["declined", "expired", "cancelled"] } } }] } } }] },
    "meetingCreated": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "meeting.created" }, "payload": { "$ref": "#/$defs/meetingPayload" } } }] },
    "meetingJoined": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "meeting.joined" }, "payload": { "allOf": [{ "$ref": "#/$defs/meetingPayload" }, { "required": ["participantConnectionId"], "properties": { "participantConnectionId": { "$ref": "#/$defs/uuid" } } }] } } }] },
    "meetingEnded": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "meeting.ended" }, "payload": { "allOf": [{ "$ref": "#/$defs/meetingPayload" }, { "required": ["reason"], "properties": { "reason": { "$ref": "#/$defs/reason" } } }] } } }] },
    "participantChanged": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "participant.changed" }, "payload": { "$ref": "#/$defs/participantChangedPayload" } } }] },
    "participantRemoved": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "participant.removed" }, "payload": { "$ref": "#/$defs/participantPayload" } } }] },
    "participantMuted": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "participant.muted" }, "payload": { "$ref": "#/$defs/participantPayload" } } }] },
    "mediaNegotiation": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "media.negotiation" }, "payload": { "$ref": "#/$defs/mediaNegotiationPayload" } } }] },
    "mediaPolicy": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "media.policy" }, "payload": { "$ref": "#/$defs/mediaPolicyPayload" } } }] },
    "mediaFailed": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "media.failed" }, "payload": { "$ref": "#/$defs/mediaFailedPayload" } } }] },
    "mediaClosed": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "media.closed" }, "payload": { "$ref": "#/$defs/mediaClosedPayload" } } }] },
    "cameraGranted": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "camera.granted" }, "payload": { "$ref": "#/$defs/mediaGrantedPayload" } } }] },
    "cameraDenied": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "camera.denied" }, "payload": { "$ref": "#/$defs/mediaDeniedPayload" } } }] },
    "cameraRevoked": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "camera.revoked" }, "payload": { "$ref": "#/$defs/mediaRevokedPayload" } } }] },
    "screenGranted": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "screen.granted" }, "payload": { "$ref": "#/$defs/mediaGrantedPayload" } } }] },
    "screenDenied": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "screen.denied" }, "payload": { "$ref": "#/$defs/mediaDeniedPayload" } } }] },
    "screenRevoked": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "screen.revoked" }, "payload": { "$ref": "#/$defs/mediaRevokedPayload" } } }] },
    "focusGranted": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "focus.granted" }, "payload": { "$ref": "#/$defs/focusGrantedPayload" } } }] },
    "focusDenied": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "focus.denied" }, "payload": { "$ref": "#/$defs/focusDeniedPayload" } } }] },
    "focusRevoked": { "allOf": [{ "$ref": "#/$defs/event" }, { "properties": { "kind": { "const": "focus.revoked" }, "payload": { "$ref": "#/$defs/focusRevokedPayload" } } }] },
    "callInvitationPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "expiresAt", "invitationId"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "expiresAt": { "$ref": "#/$defs/time" }, "invitationId": { "$ref": "#/$defs/uuid" } } }] },
    "callAcceptedPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "invitationId"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "invitationId": { "$ref": "#/$defs/uuid" } } }] },
    "callEndedPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "reason"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "reason": { "$ref": "#/$defs/reason" } } }] },
    "meetingPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["meetingId"], "properties": { "meetingId": { "$ref": "#/$defs/uuid" } } }] },
    "participantPayload": { "allOf": [{ "$ref": "#/$defs/meetingPayload" }, { "required": ["participantConnectionId"], "properties": { "participantConnectionId": { "$ref": "#/$defs/uuid" } } }] },
    "participantChangedPayload": { "allOf": [{ "$ref": "#/$defs/participantPayload" }, { "required": ["state"], "properties": { "state": { "enum": ["joined", "left"] } } }] },
    "mediaNegotiationPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "description", "descriptionType", "direction", "expiresAt", "generation", "iceServers", "negotiationId", "peerHandle", "trackBindings"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "description": { "type": "string", "minLength": 1, "maxLength": 65536 }, "descriptionType": { "enum": ["offer", "answer"] }, "direction": { "enum": ["publish", "subscribe", "duplex"] }, "expiresAt": { "$ref": "#/$defs/time" }, "generation": { "$ref": "#/$defs/sequence" }, "iceServers": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/iceServer" } }, "negotiationId": { "$ref": "#/$defs/uuid" }, "peerHandle": { "$ref": "#/$defs/reference" }, "trackBindings": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/trackBinding" } } } }] },
    "trackBinding": { "type": "object", "additionalProperties": false, "required": ["mediaKind", "publicationKind", "role", "trackReference", "transceiverMid"], "properties": { "mediaKind": { "$ref": "#/$defs/mediaKind" }, "participantConnectionId": { "$ref": "#/$defs/uuid" }, "publicationKind": { "enum": ["ptt", "call_audio", "camera", "screen"] }, "role": { "enum": ["local", "remote"] }, "trackReference": { "$ref": "#/$defs/reference" }, "transceiverMid": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" } } },
    "iceServer": { "type": "object", "additionalProperties": false, "required": ["urls"], "properties": { "credential": { "type": "string", "minLength": 1, "maxLength": 512 }, "urls": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(stun|turn|turns):" }, { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(stun|turn|turns):" } }] }, "username": { "type": "string", "minLength": 1, "maxLength": 256 } } },
    "mediaPolicyPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "canPublishCamera", "canPublishScreen", "canTransmitAudio", "generation"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "canPublishCamera": { "type": "boolean" }, "canPublishScreen": { "type": "boolean" }, "canTransmitAudio": { "type": "boolean" }, "generation": { "$ref": "#/$defs/sequence" } } }] },
    "mediaFailedPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "operation", "retryAllowed"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "operation": { "enum": ["connect", "publish", "subscribe", "renegotiate", "screen_share"] }, "retryAllowed": { "type": "boolean" } } }] },
    "mediaClosedPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "generation", "reason"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "generation": { "$ref": "#/$defs/sequence" }, "reason": { "$ref": "#/$defs/reason" } } }] },
    "mediaGrantedPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "generation", "trackReference"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "generation": { "$ref": "#/$defs/sequence" }, "trackReference": { "$ref": "#/$defs/reference" } } }] },
    "mediaDeniedPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "reason"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "reason": { "enum": ["not_allowed", "not_supported", "unavailable"] } } }] },
    "mediaRevokedPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "reason", "trackReference"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "reason": { "$ref": "#/$defs/reason" }, "trackReference": { "$ref": "#/$defs/reference" } } }] },
    "focusGrantedPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "focusReference"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "focusReference": { "$ref": "#/$defs/reference" } } }] },
    "focusDeniedPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "reason"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "reason": { "enum": ["not_allowed", "unavailable"] } } }] },
    "focusRevokedPayload": { "allOf": [{ "$ref": "#/$defs/eventPayload" }, { "required": ["callId", "focusReference", "reason"], "properties": { "callId": { "$ref": "#/$defs/uuid" }, "focusReference": { "$ref": "#/$defs/reference" }, "reason": { "$ref": "#/$defs/reason" } } }] }
  }
}
